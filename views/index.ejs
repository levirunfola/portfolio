<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Levi's Portfolio</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #11111b;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .container {
            text-align: center;
        }
        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        p {
            color: #b3b3b3;
            margin-bottom: 2rem;
        }
        .btn {
            display: inline-block;
            background: #00adb5;
            color: #fff;
            text-decoration: none;
            padding: 0.8rem 2rem;
            border-radius: 8px;
            font-weight: bold;
            transition: background 0.3s ease;
        }
        .btn:hover {
            background: #007a80;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>I am Levi Runfola</h1>
        <p>Full-Stack Developer & Systems Enthusiast</p>
        
        <a href="/contact" class="btn">Get In Touch</a>
    </div>

</body>
</html>